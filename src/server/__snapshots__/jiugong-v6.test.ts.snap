exports[`jiugong v6 server engine > matches every legacy field for 'three-character name' 1`] = `
{
  "actionDesc": "擅于企划（有计划性）、思考、内敛（隐藏）、懂得追随与接受指令、稳定、执着（固执）、坚守制度、法则、坚持理念、喜欢讲道理。

在五行中，木克土的人一定比较固执。因为"人挪生、树挪死"，树木不能移来移去，所以木克土的人一定像木头一样固执。有很强的规划能力和执行力，一旦确定目标就不轻易改变。外乡缘佳，适合在外地发展。",
  "actionRel": "克(木→土)",
  "ageStar": "倦怠星(守成星)",
  "ageStarDesc": "疲惫倦怠，宜守成",
  "ageStarFull": "倦怠星（守成星）：掌管储存、守成。当它出现那年将会带给人一种倦怠感，很容易影响一个人的动力，使人感觉疲惫。有点像流年走到衰的感觉，唯一差别是倦怠星是元神（下意识）被影响。守成的功能比突破改变还要强。宜守不宜攻，储存能量。",
  "annualStrategy": [
    {
      "文案": [
        "从阳历生日的前六个月起，你身上的能量会呈现短暂的爆发点——这个点是在突显前几年经营所累积下来的「资产值」，故此阶段可称之为「结算期」。",
        "正面频率：你过去所累积的优点、功能和附加价值，被吸引到而获得认可、任用和支持。",
        "负面频率：你过去所累积下来的缺点与错误，会引起被清算的反应；相对的，你的思绪、心态和行为举止也会产生两极化——一种有特别被肯定、获得殊荣的感觉，另一种则有被排挤、产生困惑、有些无奈的感觉。",
        "策略：请先自我结算一下前几年经营下来的成果——有多少值得你骄傲的功劳和优点，或者有多少缺失；不管是在工作上的能力表现还是人际关系的相处上，都要仔细核算一下。",
      ],
      "月份": "4月~7月",
      "标题": "生日前第六个月～前第三个月",
      "阶段": "结算期",
    },
    {
      "文案": [
        "假如你在这一段期间感觉到人气很旺、被认可度很高，或者有升级的状况出现，那真的要恭喜你——因为这代表着你的「产值很高」，请你继续努力表现，此段对你的未来不但有累积的绩效，更有加分的作用。",
        "反之，如果在这一段你觉得有一点停顿、困惑，那你得好好的反省一下——你的产值已经进入亏损阶段。",
      ],
      "月份": "8月~10月",
      "标题": "生日前两个月～生日当月",
      "阶段": "产值检验期",
    },
    {
      "文案": [
        "有瞬间的光芒、机会出现，请你仔细留意一下外围的发展状况；若上级有新的任务交代，或有其他职缺突然降临，请你不要犹豫，外调更是可行。",
        "假如是你自己想变换工作、换公司，那请你参考当年的「机会点」（即流年能量运的强弱——运只是大自然循环的阶段名词）。",
      ],
      "月份": "11月~1月",
      "标题": "生日后的第一个月～第三个月",
      "阶段": "机会点",
    },
    {
      "文案": [
        "已经开始进入「附加价值」的时段：如果在这三个月你的工作很忙碌、事情很多，那代表你的能力很强，你应该展现自己的企图心，极力争取表现。",
        "相对的，这一段若是呈现平静状况、或有点被排挤的现象，那表示你没有什么「附加价值」——建议你从这一刻开始再学习和训练，请从第二专长或管理学起。",
      ],
      "月份": "2月~4月",
      "标题": "生日后的第四个月～第六个月",
      "阶段": "附加价值期",
    },
  ],
  "arrowDown": "你的箭头指向奴仆宫（地格/子女宫）：非常会照顾子女、对朋友也很够意思，属付出型（若命格逢库破、库泄，则更显大方）。",
  "arrowSummary": "箭头越向着自己，就越能够得到那方面的帮助与机会：两个箭头都向着自己（如李嘉诚——老天爷帮他、属下支持他），格局最佳；一个向内也行；两个箭头都冲着外面别人的话，就比较辛苦了。",
  "arrowUp": "父母宫与人格五行等同（比和），无生克箭头——上下关系平顺自然，无明显的给与取。",
  "caiKuFull": {
    "描述": "受栽培、赚钱无人知，有如吸尘器由内部接收成长；靠机会、人际、组织运作，易暴起暴落。",
    "类型": "机运暗财型",
    "详解": [
      "一、容易是：受保护、栽培或企业家第二代；流行时机。凝聚力超强，没什么抗性，有带动组织功能，若只相信自己，组织做不起来。为保守派，适金融业、娱乐业、顾问业、佣金行业、高利润行业。",
      "二、赚钱无人知，有如吸尘器，由内部接收成长，很会吸钱。成长起来会回头挖墙角（内部经营）。",
      "三、周遭的人愿意卖命。污钱较不会被捉到。易暴起暴落。若跟钱过不去，不会发。最怕小气，不懂经营人际关系。",
      "四、家中无财会往外找。跟着有钱人走，很少白手起家。会吸钱，较不会花钱，库带破或泄者则会花钱。",
      "五、子女较会孝顺。本身带有艺术细胞。",
      "六、神龙见首不见尾，透过人脉操作、投资，不用浮出台面。",
      "七、疾恶宫属权星，有地下司令之称。",
      "八、财来自：先天承接百分之五十；配偶百分之二十五；因时机而得财百分之二十五。",
    ],
  },
  "caiKuJia3": [
    "一、容易是：国家保护、栽培；企业家第二代；流行时机。凝聚力超强，没什么抗性，有带动组织功能，若只相信自己，组织做不起来。为保守派，适金融业、娱乐业、顾问业、佣金行业、高利润行业。",
    "二、赚钱无人知，有如吸尘器，由内部接收成长，很会吸钱。成长起来会回头挖墙角（内部经营）。",
    "三、周遭的人愿意卖命。贪钱较不会被捉到。易暴起暴落。若跟钱过不去，不会发。最怕小气，不懂经营人际关系。",
    "四、家中无财会往外找。跟着有钱人走，很少白手起家。会吸钱，较不会花钱，库带破或泄者则会花钱。",
    "五、子女较会孝顺。本身具有艺术才华。",
    "六、神龙见首不见尾，透过人脉操作、投资，不用浮出台面。",
    "七、财来自：先天承接百分之五十；配偶百分之二十五；因时机而得财百分之二十五。",
  ],
  "caiKuJia3Note": "运作磁波属差3的特殊格局——此磁波之福禄稍小，很容易受自己影响而失半，又负3者易修福给后代；自己是属下的贵人，自己小气则属空。先付出再得到；有此老板不错，老板会照顾你。",
  "caigongXie": [
    "一、很容易有泄财现象，属于花钱享受型，有钱就花，较不懂得节制。",
    "二、泄不代表不会赚钱，而是像水龙头锁不紧，会慢慢流失。",
    "三、不会守，有人帮忙花，到老容易一场空。有如无库位可守一般。",
    "四、容易受环境影响而泄财，交错朋友，投资错误，容易被套牢。",
    "五、被亲友挖财、泄财；或赚钱太慢，不够花。",
    "六、男人库泄配女人库旺最好，老公赚钱泄给老婆花。",
    "七、要忌赌，忌投机，不做没有把握的事，并且要懂得理财（保险、记账）。",
